+static bool ggml_metal_skip_op(enum ggml_op op) {
+    static bool tab[GGML_OP_COUNT];
+    static bool init = false;
+    if (!init) {
+        init = true;
+        const char * env = getenv("GGML_METAL_SKIP_OPS");
+        if (env) {
+            char buf[512];
+            snprintf(buf, sizeof(buf), "%s", env);
+            for (char * tok = strtok(buf, ","); tok; tok = strtok(NULL, ",")) {
+                for (int i = 0; i < GGML_OP_COUNT; ++i) {
+                    if (strcmp(tok, "ALL") == 0 || strcmp(tok, ggml_op_name((enum ggml_op) i)) == 0) {
+                        tab[i] = true;
+                    }
+                }
+            }
+        }
+    }
+    return tab[op];
+}
