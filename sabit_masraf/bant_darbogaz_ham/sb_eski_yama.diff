+    const ggml_tensor * mm  = gf->nodes[idxs[0]];
+    const ggml_tensor * add = gf->nodes[idxs[1]];
+
+    if (mm->src[0]->type != GGML_TYPE_Q4_0 || mm->src[1]->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32) {
+        return false;
+    }
