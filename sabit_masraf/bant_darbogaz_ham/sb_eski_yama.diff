+        for (short t = 0; t < TM; ++t) {
+            C[t].thread_elements()[0] = fma(T2[t].thread_elements()[0], dd[t], C[t].thread_elements()[0]);
+            C[t].thread_elements()[1] = fma(T2[t].thread_elements()[1], dd[t], C[t].thread_elements()[1]);
