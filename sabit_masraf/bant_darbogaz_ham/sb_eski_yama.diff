+        return false;
+    }
+    if (!ggml_is_contiguous(mm) || !ggml_is_contiguous(add) || !ggml_is_contiguous(mm->src[1])) {
+        return false;
+    }
+
+    const ggml_tensor * other = add->src[0] == mm ? add->src[1] : add->src[0];
+
+    return other->type == GGML_TYPE_F32 && ggml_is_contiguous(other) && ggml_nelements(other) == mm->ne[0];
