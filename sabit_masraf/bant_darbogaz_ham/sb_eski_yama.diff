+            for (short t = 0; t < TM; ++t) {
+                const ushort u = (j & 1) ? ub[t] : ua[t];
+                const uint   w = (uint(u & 0xFFu) | (uint(u >> 8) << 16)) >> (j < 2 ? 0 : 4);
+                const half2  h = as_type<half2>((w & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
