+        return false;
+    }
+    if (m0->ne[1] != 1 || m0->ne[2] != 1 || m0->ne[3] != 1 || m0->src[0]->ne[2] != 1 || m0->src[0]->ne[3] != 1) {
+        return false;
+    }
+
+    return ggml_is_contiguous(m0) && ggml_is_contiguous(m1) && ggml_is_contiguous(glu) && ggml_is_contiguous(m0->src[1]);
