 #include <thread>
 #include <vector>
 
+#include <cstring>
+#include <cstdlib>
+#include <algorithm>
+#include "ggml-backend.h"
+
+static float g_seyrek_oran = 0.0f;
+static int   g_seyrek_kat_min = 0;
+static std::vector<float> g_oran_down, g_oran_up;
+
+static std::vector<float> oran_listesi(const char * s) {
+    std::vector<float> v;
+    if (!s) return v;
+    for (const char * q = s; *q; ) { v.push_back((float) atof(q)); const char * c = strchr(q, ','); if (!c) break; q = c + 1; }
+    return v;
+}
+
+static bool g_seyrek_gate = false;
+static bool g_seyrek_up = false;
+static float g_seyrek_esik = 0.0f; static double g_sifir_say = 0, g_toplam_say = 0;
+static std::vector<float> g_gate_buf;
+static int g_gate_kat = -1;
+
+// nöron istatistiği toplama (SEYREK_TOPLA=dosya): katman başına sum|silu(g)|, sum|u|, sum|h|, token sayısı
+static std::vector<std::vector<double>> g_ist_g, g_ist_u, g_ist_h;
+static std::vector<float> g_ist_gbuf, g_ist_ubuf;
+static double g_ist_n = 0;
+static int g_ist_ne0 = 0;
+static void ist_yaz() {
+    const char * yol = std::getenv("SEYREK_TOPLA"); if (!yol) return;
+    FILE * f = fopen(yol, "wb"); if (!f) return;
+    const int nk = (int) g_ist_g.size();
+    fwrite(&nk, 4, 1, f); fwrite(&g_ist_ne0, 4, 1, f); fwrite(&g_ist_n, 8, 1, f);
+    for (int k = 0; k < nk; ++k) { fwrite(g_ist_g[k].data(), 8, g_ist_ne0, f); fwrite(g_ist_u[k].data(), 8, g_ist_ne0, f); fwrite(g_ist_h[k].data(), 8, g_ist_ne0, f); }
+    fclose(f);
+    fprintf(stderr, "SEYREK_TOPLA yazildi: %d katman, %d noron, %.0f token\n", nk, g_ist_ne0, g_ist_n);
+}
+static bool seyrek_topla_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    (void) user_data;
+    const bool gate = strncmp(t->name, "ffn_gate-", 9) == 0 && t->op == GGML_OP_MUL_MAT;
+    const bool up   = strncmp(t->name, "ffn_up-", 7) == 0 && t->op == GGML_OP_MUL_MAT;
+    const bool sw   = strncmp(t->name, "ffn_swiglu-", 11) == 0;
+    if (ask) return gate || up || sw;
+    const int kat = atoi(t->name + (gate ? 9 : up ? 7 : 11));
+    const int64_t ne0 = t->ne[0], ne1 = t->ne[1];
+    if ((int) g_ist_g.size() <= kat) { g_ist_g.resize(kat + 1); g_ist_u.resize(kat + 1); g_ist_h.resize(kat + 1); }
+    if (g_ist_g[kat].empty()) { g_ist_g[kat].assign(ne0, 0); g_ist_u[kat].assign(ne0, 0); g_ist_h[kat].assign(ne0, 0); g_ist_ne0 = (int) ne0; }
+    std::vector<float> r(ne0);
+    for (int64_t j = 0; j < ne1; ++j) {
+        ggml_backend_tensor_get(t, r.data(), j * t->nb[1], ne0 * sizeof(float));
+        if (gate) { for (int64_t i = 0; i < ne0; ++i) { float x = r[i]; g_ist_g[kat][i] += fabsf(x / (1.0f + expf(-x))); } }
+        else if (up) { for (int64_t i = 0; i < ne0; ++i) g_ist_u[kat][i] += fabsf(r[i]); }
+        else { for (int64_t i = 0; i < ne0; ++i) g_ist_h[kat][i] += fabsf(r[i]); if (kat == 0) g_ist_n += 1; }
+    }
+    return true;
+}
+// seçim ağırlığı (SEYREK_AGIRLIK=dosya, SEYREK_AGIRLIK_TUR): 1 = ort|silu(g)|, 2 = ort|h|/ort|u|, 3 = sqrt(ort|silu(g)|)
+static std::vector<std::vector<float>> g_agirlik, g_agirlik_down;
+static std::vector<std::vector<float>> agirlik_oku(const char * yol, int tur) {
+    std::vector<std::vector<float>> out;
+    FILE * f = fopen(yol, "rb"); if (!f) { fprintf(stderr, "agirlik dosyasi acilamadi: %s\n", yol); exit(1); }
+    int nk = 0, ne0 = 0; double n = 0;
+    fread(&nk, 4, 1, f); fread(&ne0, 4, 1, f); fread(&n, 8, 1, f);
+    out.resize(nk);
+    std::vector<double> g(ne0), u(ne0), h(ne0);
+    for (int k = 0; k < nk; ++k) {
+        fread(g.data(), 8, ne0, f); fread(u.data(), 8, ne0, f); fread(h.data(), 8, ne0, f);
+        out[k].resize(ne0);
+        for (int i = 0; i < ne0; ++i) {
+            double w = tur == 1 ? g[i]/n : tur == 2 ? (h[i] / std::max(u[i], 1e-9)) : tur == 3 ? sqrt(g[i]/n) : 1.0;
+            out[k][i] = (float) w;
+        }
+    }
+    fclose(f);
+    return out;
+}
+// SEYREK_AGIRLIK: up seçimi ağırlığı (|u|·w). SEYREK_AGIRLIK_DOWN: down seçimi ağırlığı (|h|·w2); SEYREK_AGIRLIK_UP_DOWN=1 ise up seçimi w·w2 ile
+static void agirlik_yukle() {
+    if (const char * yol = std::getenv("SEYREK_AGIRLIK")) {
+        const int tur = std::getenv("SEYREK_AGIRLIK_TUR") ? atoi(std::getenv("SEYREK_AGIRLIK_TUR")) : 1;
+        g_agirlik = agirlik_oku(yol, tur);
+        fprintf(stderr, "SEYREK_AGIRLIK yuklendi tur %d\n", tur);
+    }
+    if (const char * yol = std::getenv("SEYREK_AGIRLIK_DOWN")) {
+        g_agirlik_down = agirlik_oku(yol, 1);
+        if (std::getenv("SEYREK_AGIRLIK_UP_DOWN")) {
+            if (g_agirlik.empty()) g_agirlik = g_agirlik_down;
+            else for (size_t k = 0; k < g_agirlik.size() && k < g_agirlik_down.size(); ++k) for (size_t i = 0; i < g_agirlik[k].size(); ++i) g_agirlik[k][i] *= g_agirlik_down[k][i];
+        }
+        fprintf(stderr, "SEYREK_AGIRLIK_DOWN yuklendi\n");
+    }
+}
+static bool seyrek_sifirla_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    (void) user_data;
+    const bool swiglu = strncmp(t->name, "ffn_swiglu-", 11) == 0;
+    const bool liste  = !g_oran_down.empty();
+    const bool gate   = (g_seyrek_up || liste) ? (strncmp(t->name, "ffn_up-", 7) == 0 && t->op == GGML_OP_MUL_MAT) : (g_seyrek_gate && strncmp(t->name, "ffn_gate-", 9) == 0 && t->op == GGML_OP_MUL_MAT);
+    if (ask) return swiglu || gate;
+    if (gate) {
+        g_gate_kat = atoi(t->name + ((g_seyrek_up || liste) ? 7 : 9));
+        g_gate_buf.resize(t->ne[0] * t->ne[1]);
+        for (int64_t j = 0; j < t->ne[1]; ++j) ggml_backend_tensor_get(t, g_gate_buf.data() + j * t->ne[0], j * t->nb[1], t->ne[0] * sizeof(float));
+        return true;
+    }
+    if (!swiglu) return true;
+    const int kat = atoi(t->name + 11);
+    static const int kat_max = std::getenv("SEYREK_KAT_MAX") ? atoi(std::getenv("SEYREK_KAT_MAX")) : 1000;
+    static const float oran2 = std::getenv("SEYREK_ORAN2") ? atof(std::getenv("SEYREK_ORAN2")) : -1.0f;
+    const bool aralik_disi = (kat < g_seyrek_kat_min || kat > kat_max);
+    if (!liste && aralik_disi && oran2 <= 0.0f) return true;
+    const int64_t ne0 = t->ne[0], ne1 = t->ne[1];
+    std::vector<float> r(ne0), a(ne0);
+    float oran = aralik_disi ? oran2 : g_seyrek_oran;
+    bool up_sec = g_seyrek_up;
+    if (liste) {
+        const float ou = (size_t) kat < g_oran_up.size() ? g_oran_up[kat] : 0.0f;
+        const float od = (size_t) kat < g_oran_down.size() ? g_oran_down[kat] : 0.0f;
+        up_sec = ou > 0.0f;
+        oran = up_sec ? ou : od;
+        if (oran <= 0.0f) return true;
+    }
+    const int64_t n_sifir = (int64_t)(oran * ne0);
+    for (int64_t j = 0; j < ne1; ++j) {
+        ggml_backend_tensor_get(t, r.data(), j * t->nb[1], ne0 * sizeof(float));
+        if (g_seyrek_gate || up_sec) {
+            if (g_gate_kat != kat) { fprintf(stderr, "gate katmani uyusmuyor %d %d\n", g_gate_kat, kat); exit(1); }
+            const float * g = g_gate_buf.data() + j * ne0;
+            if (up_sec) {
+                for (int64_t i = 0; i < ne0; ++i) a[i] = fabsf(g[i]);
+                if ((size_t) kat < g_agirlik.size()) { const float * w = g_agirlik[kat].data(); for (int64_t i = 0; i < ne0; ++i) a[i] *= w[i]; }
+            }
+            else { for (int64_t i = 0; i < ne0; ++i) { float x = g[i]; a[i] = fabsf(x / (1.0f + expf(-x))); } }
+        } else {
+            for (int64_t i = 0; i < ne0; ++i) a[i] = fabsf(r[i]);
+            if ((size_t) kat < g_agirlik_down.size()) { const float * w = g_agirlik_down[kat].data(); for (int64_t i = 0; i < ne0; ++i) a[i] *= w[i]; }
+        }
+        float esik;
+        if (g_seyrek_esik > 0.0f) {
+            float mx = 0; for (int64_t i = 0; i < ne0; ++i) mx = std::max(mx, a[i]);
+            esik = g_seyrek_esik * mx;
+            for (int64_t i = 0; i < ne0; ++i) if (a[i] < esik) g_sifir_say += 1;
+            g_toplam_say += ne0;
+        } else {
+            std::vector<float> b(a);
+            std::nth_element(b.begin(), b.begin() + n_sifir, b.end());
+            esik = b[n_sifir];
+        }
+        if (std::getenv("SEYREK_DBG") && kat == 8 && j < 4) {
+            double top = 0, kept = 0; std::vector<float> ab(ne0); for (int64_t i = 0; i < ne0; ++i) ab[i] = fabsf(r[i]);
+            for (int64_t i = 0; i < ne0; ++i) { top += ab[i]; if (a[i] >= esik) kept += ab[i]; }
+            fprintf(stderr, "DBG kat %d token %lld secilen kutle %.3f esik %.4f n_sifir %lld a0=%.4f a1=%.4f r0=%.4f\n", kat, (long long) j, kept/top, esik, (long long) n_sifir, a[0], a[1], r[0]);
+        }
+        for (int64_t i = 0; i < ne0; ++i) if (a[i] < esik) r[i] = 0.0f;
+        ggml_backend_tensor_set(t, r.data(), j * t->nb[1], ne0 * sizeof(float));
+    }
+    return true;
+}
+
