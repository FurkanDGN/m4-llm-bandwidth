+static bool ggml_metal_fuse_graph_ok(const ggml_cgraph * gf) {
+    static const int max_nodes = []() { const char * s = getenv("GGML_METAL_FUSE_MAX_NODES"); return s ? atoi(s) : INT_MAX; }();
+    static const int min_nodes = []() { const char * s = getenv("GGML_METAL_FUSE_MIN_NODES"); return s ? atoi(s) : 0; }();
