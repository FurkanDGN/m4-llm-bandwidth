+
+// SEYREK_DUMP=dir: katman başına FFN girişi (ffn_norm çıkışı, f16) ve hedef maske (en büyük %50, bit paketli) ekle
+static std::vector<std::vector<float>> g_x_buf(64);
+static int g_x_tok[64];
+static bool dump_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    (void) user_data;
+    const bool xnorm = strncmp(t->name, "ffn_norm-", 9) == 0 && t->op == GGML_OP_MUL;
+    const bool sw    = strncmp(t->name, "ffn_swiglu-", 11) == 0;
+    if (ask) return xnorm || sw;
+    const char * dir = std::getenv("SEYREK_DUMP");
+    if (xnorm) {
+        const int kat = atoi(t->name + 9);
+        const int64_t ne0 = t->ne[0], ne1 = t->ne[1];
+        g_x_buf[kat].resize(ne0 * ne1); g_x_tok[kat] = (int) ne1;
+        for (int64_t j = 0; j < ne1; ++j) ggml_backend_tensor_get(t, g_x_buf[kat].data() + j * ne0, j * t->nb[1], ne0 * sizeof(float));
+        return true;
+    }
+    if (sw) {
+        const int kat = atoi(t->name + 11);
+        const int64_t ne0 = t->ne[0], ne1 = t->ne[1];
+        if (g_x_tok[kat] != (int) ne1) { fprintf(stderr, "token sayisi uyusmuyor kat %d\n", kat); exit(1); }
+        std::vector<float> buf(ne0 * ne1);
+        for (int64_t j = 0; j < ne1; ++j) ggml_backend_tensor_get(t, buf.data() + j * ne0, j * t->nb[1], ne0 * sizeof(float));
+        char fx[256], fm[256];
+        snprintf(fx, sizeof(fx), "%s/x_k%d.f16", dir, kat);
+        snprintf(fm, sizeof(fm), "%s/m_k%d.bits", dir, kat);
+        FILE * ffx = fopen(fx, "ab"); FILE * ffm = fopen(fm, "ab");
+        const int64_t nx = g_x_buf[kat].size() / ne1;
+        std::vector<ggml_fp16_t> xh(nx);
+        std::vector<float> a(ne0), b(ne0);
+        std::vector<uint8_t> bits((ne0 + 7) / 8);
+        for (int64_t j = 0; j < ne1; ++j) {
+            for (int64_t i = 0; i < nx; ++i) xh[i] = ggml_fp32_to_fp16(g_x_buf[kat][j*nx + i]);
+            fwrite(xh.data(), sizeof(ggml_fp16_t), nx, ffx);
+            for (int64_t i = 0; i < ne0; ++i) a[i] = fabsf(buf[j*ne0 + i]);
+            b = a; std::nth_element(b.begin(), b.begin() + ne0/2, b.end());
+            const float th = b[ne0/2];
+            std::fill(bits.begin(), bits.end(), 0);
+            for (int64_t i = 0; i < ne0; ++i) if (a[i] >= th) bits[i >> 3] |= (1u << (i & 7));
+            fwrite(bits.data(), 1, bits.size(), ffm);
+        }
+        if (std::getenv("SEYREK_DUMP_H") && kat % 8 == 0) {
+            char fh[256]; snprintf(fh, sizeof(fh), "%s/h_k%d.f16", dir, kat);
+            FILE * ffh = fopen(fh, "ab");
+            std::vector<ggml_fp16_t> hh(ne0);
+            for (int64_t j = 0; j < ne1; ++j) {
+                for (int64_t i = 0; i < ne0; ++i) hh[i] = ggml_fp32_to_fp16(buf[j*ne0 + i]);
+                fwrite(hh.data(), sizeof(ggml_fp16_t), ne0, ffh);
+            }
+            fclose(ffh);
+        }
+        fclose(ffx); fclose(ffm);
+    }
+    return true;
+}
