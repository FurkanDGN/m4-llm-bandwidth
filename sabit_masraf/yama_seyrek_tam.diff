+bool ggml_metal_sb_eligible(const ggml_tensor * mm) {
+    const int64_t ne11 = mm->src[1]->ne[1];
+
+    return ggml_metal_sb_mode() != 0 &&
+        mm->src[0]->type == GGML_TYPE_Q4_0 && mm->src[1]->type == GGML_TYPE_F32 &&
+        mm->src[0]->ne[0] % 256 == 0 && ne11 >= 2 && ne11 <= 8 && (ggml_metal_sb_matrix(ne11) || ne11 <= 3) &&
+        mm->src[0]->ne[2] == 1 && mm->src[0]->ne[3] == 1 && mm->src[1]->ne[2] == 1 && mm->src[1]->ne[3] == 1 &&
+        mm->src[1]->nb[0] == sizeof(float) && mm->nb[1] == (uint64_t) mm->ne[0]*sizeof(float);
+}
+
+bool ggml_metal_sb_fusable(const ggml_tensor * mm) {
+    static const bool enabled = []() { const char * s = getenv("GGML_METAL_FUSE_SB"); return !(s && atoi(s) == 0); }();
+
+    return enabled && ggml_metal_sb_eligible(mm);
+}
+
+// single token (mat-vec kernels) or small batch with a fused variant
+static bool ggml_metal_mm_fusable_shape(const ggml_tensor * mm) {
+    if (mm->ne[1] == 1 && mm->ne[2] == 1 && mm->ne[3] == 1 && mm->src[0]->ne[2] == 1 && mm->src[0]->ne[3] == 1) {
+        return true;
+    }
+
+    return ggml_metal_sb_fusable(mm);
+}
+
+bool ggml_metal_can_fuse_mm_add(const ggml_cgraph * gf, const int * idxs) {
+    static const bool enabled = []() { const char * s = getenv("GGML_METAL_FUSE_MM_ADD"); return !(s && atoi(s) == 0); }();
+    if (!enabled || !ggml_metal_fuse_graph_ok(gf)) {
+        return false;
+    }
+
+    const enum ggml_op ops[2] = { GGML_OP_MUL_MAT, GGML_OP_ADD };
+    if (!ggml_can_fuse_ext(gf, idxs, ops, 2)) {
+        return false;
+    }
+
+    const ggml_tensor * mm  = gf->nodes[idxs[0]];
+    const ggml_tensor * add = gf->nodes[idxs[1]];
+
+    if (mm->src[0]->type != GGML_TYPE_Q4_0 || mm->src[1]->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_metal_mm_fusable_shape(mm)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(mm) || !ggml_is_contiguous(add) || !ggml_is_contiguous(mm->src[1])) {
+        return false;
+    }
+
+    const ggml_tensor * other = add->src[0] == mm ? add->src[1] : add->src[0];
+
+    if (other->type != GGML_TYPE_F32 || !ggml_is_contiguous(other)) {
+        return false;
+    }
+
+    if (mm->ne[1] == 1) {
+        return ggml_nelements(other) == mm->ne[0];
+    }
+
+    return other->ne[0] == mm->ne[0] && other->ne[2] == 1 && other->ne[3] == 1 && (other->ne[1] == mm->ne[1] || other->ne[1] == 1);
+}
+
+bool ggml_metal_can_fuse_mm_glu(const ggml_cgraph * gf, const int * idxs) {
+    static const bool enabled = []() { const char * s = getenv("GGML_METAL_FUSE_MM_GLU"); return !(s && atoi(s) == 0); }();
+    if (!enabled || !ggml_metal_fuse_graph_ok(gf)) {
+        return false;
+    }
+
+    const ggml_tensor * m0  = gf->nodes[idxs[0]];
+    const ggml_tensor * m1  = gf->nodes[idxs[1]];
+    const ggml_tensor * glu = gf->nodes[idxs[2]];
+
+    if (m0->op != GGML_OP_MUL_MAT || m1->op != GGML_OP_MUL_MAT || glu->op != GGML_OP_GLU) {
+        return false;
+    }
+    if (ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || ggml_get_op_params_i32(glu, 1) != 0) {
+        return false;
+    }
+    if (!((glu->src[0] == m0 && glu->src[1] == m1) || (glu->src[0] == m1 && glu->src[1] == m0))) {
+        return false;
+    }
+    if (!ggml_node_has_n_uses(gf, idxs[0], 1) || !ggml_node_has_n_uses(gf, idxs[1], 1)) {
+        return false;
+    }
+    if ((m0->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (m1->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (glu->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return false;
+    }
+    if (m0->src[0]->type != GGML_TYPE_Q4_0 || m1->src[0]->type != GGML_TYPE_Q4_0 ||
+        m0->src[1] != m1->src[1] || m0->src[1]->type != GGML_TYPE_F32 ||
+        m0->type != GGML_TYPE_F32 || m1->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_are_same_shape(m0, m1) || !ggml_are_same_shape(m0->src[0], m1->src[0]) ||
+        m0->src[0]->nb[1] != m1->src[0]->nb[1] || !ggml_are_same_shape(m0, glu)) {
+        return false;
+    }
+    // the scalar small-batch kernels do not get a fused glu variant, it was slower than the two separate kernels
+    if (!(m0->ne[1] == 1 && ggml_metal_mm_fusable_shape(m0)) && !(ggml_metal_sb_fusable(m0) && ggml_metal_sb_matrix((int) m0->src[1]->ne[1]))) {
+        return false;
+    }
+
+    return ggml_is_contiguous(m0) && ggml_is_contiguous(m1) && ggml_is_contiguous(glu) && ggml_is_contiguous(m0->src[1]);
+}
+
+bool ggml_metal_can_fuse_mm_qkv(const ggml_cgraph * gf, const int * idxs) {
+    static const bool enabled = []() { const char * s = getenv("GGML_METAL_FUSE_MM_QKV"); return !(s && atoi(s) == 0); }();
+    if (!enabled || !ggml_metal_fuse_graph_ok(gf)) {
+        return false;
+    }
+
+    const ggml_tensor * n[6];
+    for (int k = 0; k < 6; k++) {
+        n[k] = gf->nodes[idxs[k]];
+    }
+
+    // the scalar small-batch kernels do not get a fused qkv variant, it was slower than three separate kernels
+    if (n[0]->ne[1] != 1 && !ggml_metal_sb_matrix((int) n[0]->src[1]->ne[1])) {
+        return false;
+    }
+
+    for (int k = 0; k < 6; k += 2) {
+        if (!ggml_metal_can_fuse_mm_add(gf, idxs + k)) {
+            return false;
+        }
+    }
+
+    const ggml_tensor * x = n[0]->src[1];
+
+    const ggml_tensor * bias[3];
+
+    for (int k = 0; k < 3; k++) {
+        const ggml_tensor * mm  = n[2*k];
+        const ggml_tensor * add = n[2*k + 1];
+
+        if (mm->src[1] != x || mm->src[0]->ne[0] != n[0]->src[0]->ne[0] || mm->src[0]->nb[1] != n[0]->src[0]->nb[1]) {
+            return false;
+        }
+
+        bias[k] = add->src[0] == mm ? add->src[1] : add->src[0];
+    }
+
+    for (int k = 0; k < 3; k++) {
+        for (int m = 0; m < 6; m++) {
+            if (bias[k] == n[m] || n[2*k]->src[0] == n[m]) {
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+static int ggml_metal_use_count(const ggml_cgraph * gf, const ggml_tensor * t) {
+    const size_t pos = ggml_hash_find(&gf->visited_hash_set, t);
+    if (!ggml_bitset_get(gf->visited_hash_set.used, pos)) {
+        return 0;
+    }
+    return gf->use_counts[pos];
+}
+
+static bool ggml_metal_rope_set_rows_ok(const ggml_cgraph * gf, const ggml_tensor * rope, const ggml_tensor * view, const ggml_tensor * sr) {
+    static const bool enabled = []() { const char * s = getenv("GGML_METAL_FUSE_ROPE_K"); return !(s && atoi(s) == 0); }();
+    if (!enabled || !ggml_metal_fuse_graph_ok(gf)) {
+        return false;
+    }
+
+    if (rope->op != GGML_OP_ROPE || view->op != GGML_OP_VIEW || sr->op != GGML_OP_SET_ROWS) {
+        return false;
+    }
+    if ((rope->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (sr->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return false;
+    }
+    if (view->view_src != rope || view->view_offs != 0 || sr->src[0] != view) {
+        return false;
+    }
+    if (ggml_metal_use_count(gf, rope) != 1 || ggml_metal_use_count(gf, view) != 1) {
+        return false;
+    }
+    if ((rope->flags & GGML_TENSOR_FLAG_OUTPUT) || (view->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    const int mode = ((const int32_t *) rope->op_params)[2];
+    if (!(mode & GGML_ROPE_TYPE_NEOX) || (mode & GGML_ROPE_TYPE_MROPE) || mode == GGML_ROPE_TYPE_VISION) {
+        return false;
+    }
+    if (rope->src[0]->type != GGML_TYPE_F32 || rope->type != GGML_TYPE_F32 || rope->src[1]->type != GGML_TYPE_I32) {
+        return false;
+    }
+    if (rope->ne[3] != 1 || !ggml_is_contiguous(rope) || rope->src[1]->ne[0] != rope->ne[2]) {
+        return false;
+    }
+    if (sr->type != GGML_TYPE_F16 || sr->nb[0] != sizeof(ggml_fp16_t) || (sr->src[1]->type != GGML_TYPE_I64 && sr->src[1]->type != GGML_TYPE_I32)) {
+        return false;
+    }
+    if (view->ne[0] != rope->ne[0]*rope->ne[1] || view->ne[1] != rope->ne[2] || view->ne[2] != 1 || view->ne[3] != 1) {
+        return false;
+    }
+    if (sr->ne[0] != view->ne[0] || sr->src[1]->ne[1] != 1 || sr->src[1]->ne[2] != 1 || sr->src[1]->ne[0] != view->ne[1]) {
+        return false;
+    }
+
+    return true;
+}
+
+bool ggml_metal_can_fuse_rope_q_set_rows(const ggml_cgraph * gf, const int * idxs) {
+    static const bool enabled = []() { const char * s = getenv("GGML_METAL_FUSE_ROPE_QK"); return !(s && atoi(s) == 0); }();
+    if (!enabled || !ggml_metal_fuse_graph_ok(gf)) {
+        return false;
+    }
+
+    if (!ggml_metal_can_fuse_rope_set_rows(gf, idxs + 1)) {
+        return false;
+    }
+
+    const ggml_tensor * q = gf->nodes[idxs[0]];
+    const ggml_tensor * k = gf->nodes[idxs[1]];
+
+    if (q->op != GGML_OP_ROPE || (q->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return false;
+    }
+    if (memcmp((const int32_t *) q->op_params + 1, (const int32_t *) k->op_params + 1, 10*sizeof(int32_t)) != 0) {
+        return false;
+    }
+    if (q->src[0]->type != GGML_TYPE_F32 || q->type != GGML_TYPE_F32 || q->src[1] != k->src[1] || q->src[2] || k->src[2]) {
+        return false;
+    }
+    if (q->ne[0] != k->ne[0] || q->ne[2] != k->ne[2] || q->ne[3] != 1 || q->src[0]->ne[0] != k->src[0]->ne[0]) {
+        return false;
+    }
+
+    return true;
+}
+
+static bool ggml_metal_set_rows_v_ok(const ggml_cgraph * gf, const ggml_tensor * rope, const ggml_tensor * sr_k, const ggml_tensor * view_v, const ggml_tensor * sr_v) {
+    static const bool enabled = []() { const char * s = getenv("GGML_METAL_FUSE_SET_V"); return !(s && atoi(s) == 0); }();
+    if (!enabled || !ggml_metal_fuse_graph_ok(gf)) {
+        return false;
+    }
+
+    if (view_v->op != GGML_OP_VIEW || sr_v->op != GGML_OP_SET_ROWS || sr_v->src[0] != view_v) {
+        return false;
+    }
+    if ((sr_v->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return false;
+    }
+    if (view_v->type != GGML_TYPE_F32 || view_v->nb[0] != sizeof(float) || view_v->ne[2] != 1 || view_v->ne[3] != 1) {
+        return false;
+    }
+    if (view_v->ne[0] != rope->ne[0]*rope->ne[1] || view_v->ne[1] != rope->ne[2]) {
+        return false;
+    }
+    if (sr_v->type != GGML_TYPE_F16 || sr_v->nb[0] != sizeof(ggml_fp16_t) || sr_v->ne[0] != view_v->ne[0]) {
+        return false;
+    }
+    if (sr_v->src[1]->type != sr_k->src[1]->type || sr_v->src[1]->ne[0] != view_v->ne[1] || sr_v->src[1]->ne[1] != 1 || sr_v->src[1]->ne[2] != 1) {
+        return false;
+    }
+
+    return true;
+}
+
+bool ggml_metal_can_fuse_rope_set_rows_v(const ggml_cgraph * gf, const int * idxs) {
+    const ggml_tensor * rope = gf->nodes[idxs[0]];
+    const ggml_tensor * sr_k = gf->nodes[idxs[1]];
+    const ggml_tensor * sr_v = gf->nodes[idxs[2]];
+
+    return sr_v->op == GGML_OP_SET_ROWS && sr_v->src[0] && ggml_metal_set_rows_v_ok(gf, rope, sr_k, sr_v->src[0], sr_v);
+}
+
+bool ggml_metal_can_fuse_rope_set_rows(const ggml_cgraph * gf, const int * idxs) {
+    const ggml_tensor * rope = gf->nodes[idxs[0]];
+    const ggml_tensor * sr   = gf->nodes[idxs[1]];
+
+    return sr->op == GGML_OP_SET_ROWS && sr->src[0] && ggml_metal_rope_set_rows_ok(gf, rope, sr->src[0], sr);
+}
+
+bool ggml_metal_can_fuse_rope_view_set_rows(const ggml_cgraph * gf, int idx) {
+    if (idx + 2 >= gf->n_nodes) {
+        return false;
+    }
+
+    return ggml_metal_rope_set_rows_ok(gf, gf->nodes[idx], gf->nodes[idx + 1], gf->nodes[idx + 2]);
+}
