+    if (!hazir) {
+        hazir = true;
+        float * b0 = (float *) ((char *) ggml_metal_device_seyrek_scratch_ptr() + SEYREK_AGIRLIK_OFF);
+        for (int i = 0; i < 2*nk_g*ne0_g; ++i) b0[i] = 1.0f;
+        if (const char * yol = getenv("SEYREK_AGIRLIK")) seyrek_agirlik_dosya(b0, nk_g, ne0_g, yol, getenv("SEYREK_AGIRLIK_TUR") ? atoi(getenv("SEYREK_AGIRLIK_TUR")) : 1);
