+// seyrek gate (up-önce yolu): |u| histogramından eşik, grup içi sıkıştırma, seçili satırlar için g_i = x·W_i,
+// h_i = silu(g_i)*u_i; seçilmeyenler 0. TG = 448 iş parçacığı = 14 simdgroup, simdgroup başına bir satır.
+kernel void kernel_seyrek_gate(
+        constant ggml_metal_kargs_seyrek & args,
+        device const char  * w,
+        device const float * x,
+        device const float * u,
+        device const uint  * hist_cur,
+        device       uint  * hist_next,
+        device       float * dst,
+        device atomic_uint * sayac,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    threadgroup int   lidx[2560];
+    threadgroup uint  sg_tot[16];
+    threadgroup float th_sh;
+    threadgroup int   n_sh;
+    threadgroup float sx[112];
+
+    const int t   = tpitg3.x;
+    const int nk  = args.ne00;
+    const int nb  = nk/32;
+    const int per = (args.ne01 + args.nchunk - 1)/args.nchunk;
+    const int i0  = tgpig.x*per;
+    const int i1  = min(args.ne01, i0 + per);
+
+    if (tgpig.x == 0) { for (int b = t; b < 2048; b += 448) hist_next[b] = 0u; }
+    if (t < nb) { float s = 0.0f; for (int c = 0; c < 32; ++c) s += x[t*32 + c]; sx[t] = s; }
+
+    {
+        uint c = 0;
+        if (t < 256) { for (int b = 0; b < 8; ++b) c += hist_cur[8*t + b]; }
+        uint inc = simd_prefix_inclusive_sum(c);
+        if (tiisg == 31) sg_tot[sgitg] = inc;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        uint base = 0;
+        for (ushort q = 0; q < sgitg; ++q) base += sg_tot[q];
+        const uint k = (uint) args.n_zero;
+        if (t < 256) {
+            const uint exc = base + inc - c;
+            if (k >= exc && k < exc + c) {
+                uint kk = k - exc; int b = 0;
+                for (; b < 8; ++b) { const uint cb = hist_cur[8*t + b]; if (kk < cb) break; kk -= cb; }
+                th_sh = as_type<float>(((uint) (8*t + b)) << 20);
+            }
+        }
+        if (args.n_zero <= 0 && t == 0) th_sh = 0.0f;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    const float th = th_sh;
+
+    for (int seg = i0; seg < i1; seg += 896) {
+        int r0 = seg + t, r1 = seg + t + 448;
+        const bool s0 = r0 < i1 && fabs(u[r0]) >= th && u[r0] != 0.0f;
+        const bool s1 = r1 < i1 && fabs(u[r1]) >= th && u[r1] != 0.0f;
+        if (r0 < i1 && !s0) dst[r0] = 0.0f;
+        if (r1 < i1 && !s1) dst[r1] = 0.0f;
+        uint my = (s0 ? 1u : 0u) + (s1 ? 1u : 0u);
+        uint inc = simd_prefix_inclusive_sum(my);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (tiisg == 31) sg_tot[sgitg] = inc;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        uint base = (seg == i0) ? 0u : (uint) n_sh, tot = base;
+        for (ushort q = 0; q < 14; ++q) { if (q < sgitg) base += sg_tot[q]; tot += sg_tot[q]; }
+        uint pos = base + inc - my;
+        if (s0) lidx[pos++] = r0;
+        if (s1) lidx[pos++] = r1;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (t == 0) n_sh = (int) tot;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    const int n = n_sh;
+    if (t == 0) { atomic_fetch_add_explicit(sayac, (uint) n, memory_order_relaxed); atomic_fetch_add_explicit(sayac + 1, 1u, memory_order_relaxed); }
+
+    for (int l = sgitg; l < n; l += 14) {
+        const int i = lidx[l];
+        device const char * row = w + (uint64_t) i*args.nb_row;
+        float g = 0.0f;
+        for (int b = tiisg; b < nb; b += 32) {
+            device const ushort * p = (device const ushort *) (row + b*18);
+            const float d = float(as_type<half>(p[0]));
+            const packed_ushort4 qa = *(device const packed_ushort4 *) (p + 1);
+            const packed_ushort4 qb = *(device const packed_ushort4 *) (p + 5);
+            const ushort qq[8] = { qa.x, qa.y, qa.z, qa.w, qb.x, qb.y, qb.z, qb.w };
+            device const float * xb = x + b*32;
+            float acc = 0.0f;
+            for (int uu = 0; uu < 8; ++uu) {
+                const uint v = qq[uu];
+                acc = fma((float)(v & 0x000Fu), xb[2*uu],      acc);
+                acc = fma((float)(v & 0x00F0u), xb[2*uu + 16]*0.0625f, acc);
+                acc = fma((float)(v & 0x0F00u), xb[2*uu + 1]*0.00390625f, acc);
+                acc = fma((float)(v & 0xF000u), xb[2*uu + 17]*0.000244140625f, acc);
+            }
+            g = fma(d, acc - 8.0f*sx[b], g);
+        }
+        g = simd_sum(g);
+        if (tiisg == 0) {
+            dst[i] = (g/(1.0f + exp(-g)))*u[i];
+        }
+    }
+}
