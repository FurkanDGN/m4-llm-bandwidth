+// seçim ağırlıkları: SEYREK_AGIRLIK=ist.bin (perplexity SEYREK_TOPLA çıktısı), SEYREK_AGIRLIK_TUR 1 = ort|silu(g)|, 2 = ort|h|/ort|u|
+static void seyrek_agirlik_dosya(float * base, int nk_g, int ne0_g, const char * yol, int tur) {
+    FILE * f = fopen(yol, "rb");
+    if (!f) { fprintf(stderr, "SEYREK_AGIRLIK acilamadi: %s\n", yol); exit(1); }
+    int nk = 0, ne0 = 0; double n = 0;
+    fread(&nk, 4, 1, f); fread(&ne0, 4, 1, f); fread(&n, 8, 1, f);
+    if (nk > nk_g || ne0 != ne0_g) { fprintf(stderr, "SEYREK_AGIRLIK boyut uyusmuyor %d %d\n", nk, ne0); exit(1); }
+    std::vector<double> g(ne0), u(ne0), h(ne0);
+    for (int k = 0; k < nk; ++k) {
+        fread(g.data(), 8, ne0, f); fread(u.data(), 8, ne0, f); fread(h.data(), 8, ne0, f);
+        for (int i = 0; i < ne0; ++i) {
+            const double w = tur == 1 ? g[i]/n : tur == 2 ? h[i]/std::max(u[i], 1e-9) : 1.0;
+            base[k*ne0 + i] = (float) w;
+        }
+    }
+    fclose(f);
+    fprintf(stderr, "secim agirligi yuklendi: %s (tur %d, %d katman)\n", yol, tur, nk);
