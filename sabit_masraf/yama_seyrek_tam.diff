+            device float * dst_f32 = (device float *) dst + (uint64_t)i1m*args.ne0*args.ne1 + (uint64_t)(i11 + ir1)*args.ne0;
+
+            if (i01 < args.ne01) {
+                dst_f32[i01] = sumf[ir1];
+            }
+        }
+    }
+}
+
+// mat-vec kernel processing in chunks of float4x4
+template<short r1ptg, typename q_t, short chpb, void (*deq_t4x4)(device const q_t *, short, thread float4x4 &) >
+void kernel_mul_mv_ext_q4x4_f32_impl(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG   = FC_mul_mv_nsg;
+    const short nxpsg = FC_mul_mv_nxpsg;
+
+    const short chpt = 1;
+
+  //const short nxpsg = (32);
+    const short nypsg = (32/nxpsg);
+
+    const short tx = tiisg%nxpsg;
+    const short ty = tiisg/nxpsg;
+
+    const int i01 = tgpig.x*(nypsg*NSG) + nypsg*sgitg + ty;
+    const int i11 = tgpig.y*r1ptg;
+    const int i1m = tgpig.z;
+
+    const int i12 = i1m%FC_mul_mv_ne12;
+    const int i13 = i1m/FC_mul_mv_ne12;
+
+    const uint64_t offset0 = i01*args.nb01 + (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+    const uint64_t offset1 = i11*args.nb11 + (i12        )*args.nb12 + (i13        )*args.nb13;
+
+    device const q_t * xq = (i01 < args.ne01) ? (device const q_t *) (src0 + offset0) + tx/chpb : (device const q_t *) src0;
+
+    device const float4x4 * y4x4[r1ptg];
+
+    for (int ir1 = 0; ir1 < r1ptg; ++ir1) {
+        y4x4[ir1] = (i11 + ir1 < args.ne11) ? (device const float4x4 *) (src1 + offset1 + ir1*args.nb11) + tx : (device const float4x4 *) src1;
+    }
+
+    float sumf[r1ptg] = { [ 0 ... r1ptg - 1 ] = 0.0f };
+
+    short cch = tx%chpb;
+
+    for (int ich = tx; 16*ich < args.ne00; ich += chpt*nxpsg) {
+        float4x4 lx[chpt];
+
+#pragma unroll(chpt)
+        for (short ch = 0; ch < chpt; ++ch) {
+            deq_t4x4(xq, cch, lx[ch]);
+
+            cch += nxpsg;
+            if (cch >= chpb) {
+                xq  += cch/chpb;
+                cch %= chpb;
+            }
+        }
+
+#pragma unroll(chpt)
+        for (short ch = 0; ch < chpt; ++ch) {
+#pragma unroll(r1ptg)
+            for (short ir1 = 0; ir1 < r1ptg; ++ir1) {
+                sumf[ir1] +=
+                    dot(lx[ch][0], y4x4[ir1][ch*nxpsg][0]) +
+                    dot(lx[ch][1], y4x4[ir1][ch*nxpsg][1]) +
+                    dot(lx[ch][2], y4x4[ir1][ch*nxpsg][2]) +
+                    dot(lx[ch][3], y4x4[ir1][ch*nxpsg][3]);
+
+            }
+        }
+
+#pragma unroll(r1ptg)
+        for (short ir1 = 0; ir1 < r1ptg; ++ir1) {
+            y4x4[ir1] += chpt*nxpsg;
+        }
+    }
+
+    for (short ir1 = 0; ir1 < r1ptg; ++ir1) {
+        if (nxpsg >= 32) {
+            sumf[ir1] += simd_shuffle_down(sumf[ir1], 16);
+        }
+        if (nxpsg >= 16) {
+            sumf[ir1] += simd_shuffle_down(sumf[ir1],  8);
+        }
+        if (nxpsg >= 8) {
+            sumf[ir1] += simd_shuffle_down(sumf[ir1],  4);
+        }
+        if (nxpsg >= 4) {
+            sumf[ir1] += simd_shuffle_down(sumf[ir1],  2);
+        }
+        if (nxpsg >= 2) {
+            sumf[ir1] += simd_shuffle_down(sumf[ir1],  1);
+        }
+
+        //sumf[ir1] = simd_sum(sumf[ir1]);
+    }
+
+    if (tx == 0) {
+        for (short ir1 = 0; ir1 < r1ptg && i11 + ir1 < args.ne11; ++ir1) {
+            device float * dst_f32 = (device float *) dst + (uint64_t)i1m*args.ne0*args.ne1 + (uint64_t)(i11 + ir1)*args.ne0;
+
+            if (i01 < args.ne01) {
+                dst_f32[i01] = sumf[ir1];
+            }
+        }
+    }
+}
+
+// dispatchers needed for compile-time nxpsg
+// epb - elements per quantization block
+template<short r1ptg, typename q_t, short epb, void (*deq_t4)(device const q_t *, short, thread float4 &)>
+kernel void kernel_mul_mv_ext_q4_f32_disp(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    kernel_mul_mv_ext_q4_f32_impl<r1ptg, q_t, epb/4, deq_t4>(args, src0, src1, dst, tgpig, tiisg, sgitg);
+}
+
+template<short r1ptg, typename q_t, short epb, void (*deq_t4x4)(device const q_t *, short, thread float4x4 &)>
+kernel void kernel_mul_mv_ext_q4x4_f32_disp(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    kernel_mul_mv_ext_q4x4_f32_impl<r1ptg, q_t, epb/16, deq_t4x4>(args, src0, src1, dst, tgpig, tiisg, sgitg);
+}
+
+// small-batch q4_0 kernels (BS 2..8): the weights are read once and applied to all columns
+//   sb_deq2m: two nibbles held in 16-bit lanes -> float2 via the half exponent trick; low nibbles
+//   (m = 0x000F000F, off = 1032) give nibble - 8, high nibbles in place (m = 0x00F000F0, off = 1152) give 16*(nibble - 8)
+inline float2 sb_deq2m(uint w, uint m, half off) {
+    return float2(as_type<half2>((w & m) | 0x64006400u) - half2(off));
+}
+
+// one thread handles 8 consecutive weights of NR rows and shares the src1 loads across the rows
+template<short NB, short NR>
+kernel void kernel_mul_mv_sb_q4_0_f32(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    const int row0 = (tgpig.x*4 + sgitg)*NR;
+    const int nch  = args.ne00/8;
+
+    device const char * rp[NR];
+    for (short r = 0; r < NR; ++r) {
+        rp[r] = src0 + (uint64_t) min(row0 + r, args.ne01 - 1)*args.nb01;
+    }
+
+    float acc[NR][NB];
+    for (short r = 0; r < NR; ++r) {
+        for (short c = 0; c < NB; ++c) {
+            acc[r][c] = 0.0f;
+        }
+    }
+
+    for (int ci = tiisg; ci < nch; ci += 32) {
+        const int   blk = ci >> 2;
+        const short cc  = ci & 3;
+        const short bo  = (cc & 1)*4;
+        const uint  dm  = cc < 2 ? 0x000F000Fu : 0x00F000F0u;
+        const half  dof = cc < 2 ? 1032.0h : 1152.0h;
+        const float dsc = cc < 2 ? 1.0f : 0.0625f;
+
+        float4 xl[NB];
+        float4 xh[NB];
+        for (short c = 0; c < NB; ++c) {
+            device const float4 * xp = (device const float4 *) (src1 + (uint64_t) c*args.nb11) + 2*ci;
+            xl[c] = xp[0];
+            xh[c] = xp[1];
+        }
+
+        for (short r = 0; r < NR; ++r) {
+            device const block_q4_0 * bq = (device const block_q4_0 *) rp[r] + blk;
+            device const ushort * qs = (device const ushort *) bq->qs + bo;
+
+            const uint wa = uint(qs[0]) | (uint(qs[1]) << 16);
+            const uint wb = uint(qs[2]) | (uint(qs[3]) << 16);
+
+            const float2 p02 = sb_deq2m(wa, dm, dof);
+            const float2 p13 = sb_deq2m(wa >> 8, dm, dof);
+            const float2 p46 = sb_deq2m(wb, dm, dof);
+            const float2 p57 = sb_deq2m(wb >> 8, dm, dof);
+            const float  d   = float(bq->d)*dsc;
+
+            for (short c = 0; c < NB; ++c) {
+                float a = p02.x*xl[c].x;
+                a = fma(p02.y, xl[c].z, a);
+                a = fma(p13.x, xl[c].y, a);
+                a = fma(p13.y, xl[c].w, a);
+                a = fma(p46.x, xh[c].x, a);
+                a = fma(p46.y, xh[c].z, a);
+                a = fma(p57.x, xh[c].y, a);
+                a = fma(p57.y, xh[c].w, a);
+                acc[r][c] = fma(a, d, acc[r][c]);
+            }
+        }
+    }
+
+    device float * dst_f32 = (device float *) dst;
+    for (short r = 0; r < NR; ++r) {
+        for (short c = 0; c < NB; ++c) {
+            const float sum = simd_sum(acc[r][c]);
+            if (tiisg == 0 && row0 + r < args.ne01) {
+                dst_f32[(uint64_t) c*args.ne0 + row0 + r] = sum;
+            }
+        }
+    }
+}
+
+
+// seyrek down: token başına en küçük n_zero |h| değerinin eşiğini bul (radix seçimi, 4 geçiş), dst'yi sıfırla
+kernel void kernel_seyrek_esik(
+        constant ggml_metal_kargs_seyrek & args,
+        device const float * h,
+        device       float * thr,
+        device       float * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]]) {
+    const ushort tpitg = tpitg3.x;
+    threadgroup atomic_uint hist[256];
+    threadgroup uint sel_prefix;
+    threadgroup int  sel_k;
+
+    const int t = tgpig.x;
+    device const float * hp = h + (uint64_t) t*args.nb11/sizeof(float);
+
+    // dst sütununu sıfırla
+    for (int j = tpitg; j < args.ne01; j += 256) {
+        dst[(uint64_t) t*args.ne01 + j] = 0.0f;
+    }
+
+    if (tpitg == 0) { sel_prefix = 0; sel_k = args.n_zero; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (int pass = 0; pass < 4; ++pass) {
+        const int shift = 24 - 8*pass;
+        const uint hmask = pass == 0 ? 0u : (0xFFFFFFFFu << (shift + 8));
+        atomic_store_explicit(&hist[tpitg], 0u, memory_order_relaxed);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        const uint prefix = sel_prefix;
+        for (int i = tpitg; i < args.ne00; i += 256) {
+            const uint v = as_type<uint>(fabs(hp[i]));
+            if ((v & hmask) == prefix) {
+                atomic_fetch_add_explicit(&hist[(v >> shift) & 0xFF], 1u, memory_order_relaxed);
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (tpitg == 0) {
+            int k = sel_k;
+            uint b = 0;
+            for (; b < 256; ++b) {
+                const int c = (int) atomic_load_explicit(&hist[b], memory_order_relaxed);
+                if (k < c) break;
+                k -= c;
+            }
+            if (b > 255) b = 255;
+            sel_prefix = prefix | (b << shift);
+            sel_k = k;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (tpitg == 0) {
+        thr[t] = args.n_zero > 0 ? as_type<float>(sel_prefix) : 0.0f;
+    }
+}
+
+// seyrek down: out[j] += sum_i h[i] * W[i][j], yalnız |h[i]| >= thr olan nöronlar okunur.
+// grid: x = 512'lik sütun dilimi, y = nöron parçası, z = 8'lik token grubu. 128 iş parçacığı, her biri 4 sütun.
+kernel void kernel_seyrek_down(
+        constant ggml_metal_kargs_seyrek & args,
+        device const char  * w,
+        device const float * h,
+        device const float * thr,
+        device       float * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]]) {
+    const ushort tpitg = tpitg3.x;
+    const int col0 = tgpig.x*512;
+    const int blk  = tpitg >> 3;        // 16 blok
+    const int u    = tpitg & 7;         // blok içi ushort indeksi
+    const int t0   = tgpig.z*8;
+    const int nt   = min(8, args.ne11 - t0);
+
+    const int per  = (args.ne00 + args.nchunk - 1)/args.nchunk;
+    const int i0   = tgpig.y*per;
+    const int i1   = min(args.ne00, i0 + per);
+
+    float th[8];
+    for (int c = 0; c < 8; ++c) th[c] = c < nt ? thr[t0 + c] : INFINITY;
+
+    float acc[8][4];
+    for (int c = 0; c < 8; ++c) for (int q = 0; q < 4; ++q) acc[c][q] = 0.0f;
+
+    const uint64_t boff = (uint64_t) (col0/32 + blk)*18;
+
+    for (int i = i0; i < i1; ++i) {
+        float x[8];
+        bool any = false;
+        for (int c = 0; c < 8; ++c) {
+            const float v = c < nt ? h[(uint64_t) (t0 + c)*args.nb11/sizeof(float) + i] : 0.0f;
+            const bool s = fabs(v) >= th[c] && v != 0.0f;
+            x[c] = s ? v : 0.0f;
+            any = any || s;
+        }
+        if (!any) continue;
+
+        device const block_q4_0 * bq = (device const block_q4_0 *) (w + (uint64_t) i*args.nb_row + boff);
+        const float  d  = float(bq->d);
+        const ushort ww = ((device const ushort *) bq->qs)[u];
+        const float w0 = (float)( ww        & 0xF) - 8.0f;
+        const float w1 = (float)((ww >>  8) & 0xF) - 8.0f;
+        const float w2 = (float)((ww >>  4) & 0xF) - 8.0f;
+        const float w3 = (float)((ww >> 12) & 0xF) - 8.0f;
+        for (int c = 0; c < 8; ++c) {
+            const float xd = x[c]*d;
+            acc[c][0] = fma(w0, xd, acc[c][0]);
+            acc[c][1] = fma(w1, xd, acc[c][1]);
+            acc[c][2] = fma(w2, xd, acc[c][2]);
+            acc[c][3] = fma(w3, xd, acc[c][3]);
+        }
+    }
+
+    const int cb = col0 + blk*32;
+    const int cols[4] = { cb + 2*u, cb + 2*u + 1, cb + 2*u + 16, cb + 2*u + 17 };
+    for (int c = 0; c < nt; ++c) {
+        device atomic_float * o = (device atomic_float *) (dst + (uint64_t) (t0 + c)*args.ne01);
+        for (int q = 0; q < 4; ++q) {
+            if (acc[c][q] != 0.0f) atomic_fetch_add_explicit(o + cols[q], acc[c][q], memory_order_relaxed);
+        }
+    }
+}
+
+
+// seyrek down v2 (ne11 <= 8): 256 iş parçacığı = 8 simdgroup; her TG 128 sütun (4 blok), satırlar simdgroup'lar arasında dönüşümlü.
+// Kısmi toplamlar part[y][t][col]'a yazılır, kernel_seyrek_topla toplar. Atomik yok.
+kernel void kernel_seyrek_down2(
+        constant ggml_metal_kargs_seyrek & args,
+        device const char  * w,
+        device const float * h,
+        device const float * thr,
+        device       float * part,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    threadgroup float red[8][8][128];
+
+    const int col0 = tgpig.x*128;
+    const int blk  = tiisg >> 3;
+    const int u    = tiisg & 7;
+    const int nt   = args.ne11;
+
+    const int per  = (args.ne00 + args.nchunk - 1)/args.nchunk;
+    const int i0   = tgpig.y*per;
+    const int i1   = min(args.ne00, i0 + per);
+
+    float th[8];
+    for (int c = 0; c < 8; ++c) th[c] = c < nt ? thr[c] : INFINITY;
+
+    float acc[8][4];
+    for (int c = 0; c < 8; ++c) for (int q = 0; q < 4; ++q) acc[c][q] = 0.0f;
+
+    const uint64_t boff = (uint64_t) (col0/32 + blk)*18;
+    const uint64_t hs = args.nb11/sizeof(float);
+
+    for (int i = i0 + sgitg; i < i1; i += 8) {
+        float x[8];
+        bool any = false;
+        for (int c = 0; c < 8; ++c) {
+            const float v = c < nt ? h[(uint64_t) c*hs + i] : 0.0f;
+            const bool sel = fabs(v) >= th[c] && v != 0.0f;
+            x[c] = sel ? v : 0.0f;
+            any = any || sel;
+        }
+        if (!any) continue;
+
+        device const block_q4_0 * bq = (device const block_q4_0 *) (w + (uint64_t) i*args.nb_row + boff);
+        const ushort ww = ((device const ushort *) bq->qs)[u];
+        const float  d  = float(bq->d);
+        const float w0 = (float)( ww        & 0xF) - 8.0f;
+        const float w1 = (float)((ww >>  8) & 0xF) - 8.0f;
+        const float w2 = (float)((ww >>  4) & 0xF) - 8.0f;
+        const float w3 = (float)((ww >> 12) & 0xF) - 8.0f;
+        for (int c = 0; c < 8; ++c) {
+            const float xd = x[c]*d;
+            acc[c][0] = fma(w0, xd, acc[c][0]);
+            acc[c][1] = fma(w1, xd, acc[c][1]);
+            acc[c][2] = fma(w2, xd, acc[c][2]);
+            acc[c][3] = fma(w3, xd, acc[c][3]);
+        }
+    }
+
+    const int lc[4] = { blk*32 + 2*u, blk*32 + 2*u + 1, blk*32 + 2*u + 16, blk*32 + 2*u + 17 };
+    for (int c = 0; c < 8; ++c) for (int q = 0; q < 4; ++q) red[sgitg][c][lc[q]] = acc[c][q];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const int tid = sgitg*32 + tiisg; // 0..255
+    for (int idx = tid; idx < 8*128; idx += 256) {
+        const int c = idx >> 7, col = idx & 127;
+        if (c < nt) {
+            float sum = 0.0f;
+            for (int s = 0; s < 8; ++s) sum += red[s][c][col];
+            part[((uint64_t) tgpig.y*nt + c)*args.ne01 + col0 + col] = sum;
+        }
+    }
+}
+
+kernel void kernel_seyrek_topla(
+        constant ggml_metal_kargs_seyrek & args,
+        device const float * part,
+        device       float * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]]) {
+    const int col = tgpig.x*256 + tpitg3.x;
+    if (col >= args.ne01) return;
+    for (int c = 0; c < args.ne11; ++c) {
+        float sum = 0.0f;
+        for (int y = 0; y < args.nchunk; ++y) sum += part[((uint64_t) y*args.ne11 + c)*args.ne01 + col];
+        dst[(uint64_t) c*args.ne01 + col] = sum;
+    }
+}
+
+
+// seyrek down, tek token: TG = ne01/32 iş parçacığı (satır genişliği), her iş parçacığı bir q4_0 bloğu (32 sütun).
+// TG y = satır parçası. 4 satır önden yüklenir. Kısmi toplam part[y][col].
+kernel void kernel_seyrek_down1(
+        constant ggml_metal_kargs_seyrek & args,
+        device const char  * w,
+        device const float * h,
+        device const float * thr,
+        device       float * part,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]]) {
+    threadgroup float red[2][3584];
+
+    const int nblk = args.ne01/32;
+    const int sub  = tpitg3.x / nblk;      // 0..3
+    const int blk  = tpitg3.x - sub*nblk;
+    const int per  = (args.ne00 + args.nchunk - 1)/args.nchunk;
+    const int i0   = tgpig.x*per;
+    const int i1   = min(args.ne00, i0 + per);
+    const float th = args.n_zero > 0 ? thr[0] : 0.0f;
+
+    float acc[32];
+    for (int q = 0; q < 32; ++q) acc[q] = 0.0f;
+
+    device const char * wb = w + (uint64_t) blk*18;
+
+#define SEYREK_ROW(xd, qa, qb) { \
+        const ushort qq[8] = { qa.x, qa.y, qa.z, qa.w, qb.x, qb.y, qb.z, qb.w }; \
+        for (int u = 0; u < 8; ++u) { \
+            const uint v = qq[u]; \
+            acc[2*u]      = fma((float)( v        & 0xF) - 8.0f, xd, acc[2*u]); \
+            acc[2*u + 1]  = fma((float)((v >>  8) & 0xF) - 8.0f, xd, acc[2*u + 1]); \
+            acc[2*u + 16] = fma((float)((v >>  4) & 0xF) - 8.0f, xd, acc[2*u + 16]); \
+            acc[2*u + 17] = fma((float)((v >> 12) & 0xF) - 8.0f, xd, acc[2*u + 17]); \
+        } }
+
+    // alt parça sub, satırları 4'er atlayarak alır; 8 satır önden yüklenir
+    int i = i0 + sub;
+    for (; i + 28 < i1; i += 32) {
+        float x[8]; bool sel[8];
+        for (int r = 0; r < 8; ++r) { x[r] = h[i + 4*r]; sel[r] = fabs(x[r]) >= th && x[r] != 0.0f; }
+        packed_ushort4 qa[8], qb[8]; ushort dd[8];
+        for (int r = 0; r < 8; ++r) {
+            if (sel[r]) {
+                device const ushort * p = (device const ushort *) (wb + (uint64_t) (i + 4*r)*args.nb_row);
+                dd[r] = p[0];
+                qa[r] = *(device const packed_ushort4 *) (p + 1);
+                qb[r] = *(device const packed_ushort4 *) (p + 5);
+            }
+        }
+        for (int r = 0; r < 8; ++r) {
+            if (!sel[r]) continue;
+            const float xd = x[r]*float(as_type<half>(dd[r]));
+            SEYREK_ROW(xd, qa[r], qb[r]);
+        }
+    }
+    for (; i < i1; i += 4) {
+        const float x = h[i];
+        if (!(fabs(x) >= th && x != 0.0f)) continue;
+        device const ushort * p = (device const ushort *) (wb + (uint64_t) i*args.nb_row);
+        const float xd = x*float(as_type<half>(p[0]));
+        const packed_ushort4 qa = *(device const packed_ushort4 *) (p + 1);
+        const packed_ushort4 qb = *(device const packed_ushort4 *) (p + 5);
+        SEYREK_ROW(xd, qa, qb);
+    }
+#undef SEYREK_ROW
+
+    const int c0 = blk*32;
+    if (sub >= 2) { for (int q = 0; q < 32; ++q) red[sub - 2][c0 + q] = acc[q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub < 2)  { for (int q = 0; q < 32; ++q) acc[q] += red[sub][c0 + q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 1) { for (int q = 0; q < 32; ++q) red[0][c0 + q] = acc[q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 0) {
+        device float * out = part + (uint64_t) tgpig.x*args.ne01 + c0;
+        for (int q = 0; q < 32; ++q) out[q] = acc[q] + red[0][c0 + q];
+    }
+}
+
+
+// 1024 iş parçacığı için kapsayıcı tarama (threadgroup içinde). Dönüş: kapsayıcı önek; total'a toplam yazılır.
+static inline uint seyrek_scan1024(uint v, threadgroup uint * sg_tot, ushort tiisg, ushort sgitg, thread uint & total) {
+    uint inc = simd_prefix_inclusive_sum(v);
+    if (tiisg == 31) sg_tot[sgitg] = inc;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    uint base = 0;
+    for (ushort s = 0; s < sgitg; ++s) base += sg_tot[s];
+    total = 0;
+    for (ushort s = 0; s < 32; ++s) total += sg_tot[s];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    return base + inc;
+}
+
+// tek token: logaritmik histogramla eşik (2048 kutu: üs + 3 mantis biti), sonra seçili satır indekslerini sıkıştır.
+// cikti: thr[0] = eşik, cnt[0] = seçili sayısı, idx[0..cnt) = satır indeksleri
+kernel void kernel_seyrek_esik2(
+        constant ggml_metal_kargs_seyrek & args,
+        device const float * h,
+        device       float * thr,
+        device       uint  * cnt,
+        device       int   * idx,
+        ushort3 tpitg3[[thread_position_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    threadgroup atomic_uint hist[2048];
+    threadgroup uint sg_tot[32];
+    threadgroup float th_sh;
+
+    const ushort t = tpitg3.x;
+    atomic_store_explicit(&hist[2*t], 0u, memory_order_relaxed);
+    atomic_store_explicit(&hist[2*t + 1], 0u, memory_order_relaxed);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (int i = t; i < args.ne00; i += 1024) {
+        const uint b = (as_type<uint>(fabs(h[i])) >> 20) & 0x7FF;
+        atomic_fetch_add_explicit(&hist[b], 1u, memory_order_relaxed);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const uint c0 = atomic_load_explicit(&hist[2*t], memory_order_relaxed);
+    const uint c1 = atomic_load_explicit(&hist[2*t + 1], memory_order_relaxed);
+    uint total;
+    const uint inc = seyrek_scan1024(c0 + c1, sg_tot, tiisg, sgitg, total);
+    const uint exc = inc - c0 - c1;
+    const uint k = (uint) args.n_zero;
+    // k, [exc, exc+c0) içindeyse kutu 2t; [exc+c0, inc) içindeyse kutu 2t+1
+    if (k >= exc && k < inc) {
+        const uint b = (k < exc + c0) ? 2*t : 2*t + 1;
+        th_sh = as_type<float>(b << 20);
+    }
+    if (args.n_zero <= 0 && t == 0) th_sh = 0.0f;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const float th = th_sh;
+
+    // sıkıştırma
+    const int per = (args.ne00 + 1023)/1024;
+    const int j0 = t*per, j1 = min(args.ne00, j0 + per);
+    uint my = 0;
+    for (int i = j0; i < j1; ++i) { const float v = h[i]; my += (fabs(v) >= th && v != 0.0f) ? 1u : 0u; }
+    uint tot2;
+    const uint pos_inc = seyrek_scan1024(my, sg_tot, tiisg, sgitg, tot2);
+    uint pos = pos_inc - my;
+    for (int i = j0; i < j1; ++i) { const float v = h[i]; if (fabs(v) >= th && v != 0.0f) idx[pos++] = i; }
+    if (t == 0) { thr[0] = th; cnt[0] = tot2; }
+}
+
+// tek token, indeks listesiyle: TG = 4 x (ne01/32) iş parçacığı, parça x = listenin bir dilimi
+kernel void kernel_seyrek_down1i(
+        constant ggml_metal_kargs_seyrek & args,
+        device const char  * w,
+        device const float * h,
+        device const uint  * cnt,
+        device const int   * idx,
+        device       float * part,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]]) {
+    threadgroup float red[2][3584];
+
+    const int nblk = args.ne01/32;
+    const int sub  = tpitg3.x / nblk;
+    const int blk  = tpitg3.x - sub*nblk;
+    const int n    = (int) cnt[0];
+    const int per  = (n + args.nchunk - 1)/args.nchunk;
+    const int i0   = tgpig.x*per;
+    const int i1   = min(n, i0 + per);
+
+    float acc[32];
+    for (int q = 0; q < 32; ++q) acc[q] = 0.0f;
+
+    device const char * wb = w + (uint64_t) blk*18;
+
+#define SEYREK_ROW(xd, qa, qb) { \
+        const ushort qq[8] = { qa.x, qa.y, qa.z, qa.w, qb.x, qb.y, qb.z, qb.w }; \
+        for (int u = 0; u < 8; ++u) { \
+            const uint v = qq[u]; \
+            acc[2*u]      = fma((float)( v        & 0xF) - 8.0f, xd, acc[2*u]); \
+            acc[2*u + 1]  = fma((float)((v >>  8) & 0xF) - 8.0f, xd, acc[2*u + 1]); \
+            acc[2*u + 16] = fma((float)((v >>  4) & 0xF) - 8.0f, xd, acc[2*u + 16]); \
+            acc[2*u + 17] = fma((float)((v >> 12) & 0xF) - 8.0f, xd, acc[2*u + 17]); \
+        } }
+
+    int l = i0 + sub;
+    for (; l + 28 < i1; l += 32) {
+        int ii[8]; float x[8];
+        for (int r = 0; r < 8; ++r) { ii[r] = idx[l + 4*r]; x[r] = h[ii[r]]; }
+        packed_ushort4 qa[8], qb[8]; ushort dd[8];
+        for (int r = 0; r < 8; ++r) {
+            device const ushort * p = (device const ushort *) (wb + (uint64_t) ii[r]*args.nb_row);
+            dd[r] = p[0];
+            qa[r] = *(device const packed_ushort4 *) (p + 1);
+            qb[r] = *(device const packed_ushort4 *) (p + 5);
+        }
+        for (int r = 0; r < 8; ++r) {
+            const float xd = x[r]*float(as_type<half>(dd[r]));
+            SEYREK_ROW(xd, qa[r], qb[r]);
+        }
+    }
+    for (; l < i1; l += 4) {
+        const int i = idx[l];
+        device const ushort * p = (device const ushort *) (wb + (uint64_t) i*args.nb_row);
+        const float xd = h[i]*float(as_type<half>(p[0]));
+        const packed_ushort4 qa = *(device const packed_ushort4 *) (p + 1);
+        const packed_ushort4 qb = *(device const packed_ushort4 *) (p + 5);
+        SEYREK_ROW(xd, qa, qb);
+    }
+#undef SEYREK_ROW
+
+    const int c0 = blk*32;
+    if (sub >= 2) { for (int q = 0; q < 32; ++q) red[sub - 2][c0 + q] = acc[q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub < 2)  { for (int q = 0; q < 32; ++q) acc[q] += red[sub][c0 + q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 1) { for (int q = 0; q < 32; ++q) red[0][c0 + q] = acc[q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 0) {
+        device float * out = part + (uint64_t) tgpig.x*args.ne01 + c0;
+        for (int q = 0; q < 32; ++q) out[q] = acc[q] + red[0][c0 + q];
+    }
+}
