+
+// seyrek down, histogramlı: eşik GLU'nun doldurduğu 2048 kutulu histogramdan, sıkıştırma grup içinde.
+// TG = 448 iş parçacığı (4 alt parça x 112 blok). hist_cur okunur, hist_next sıfırlanır (TG 0).
+kernel void kernel_seyrek_down1h(
+        constant ggml_metal_kargs_seyrek & args,
+        device const char  * w,
+        device const float * h,
+        device const uint  * hist_cur,
+        device       uint  * hist_next,
+        device       float * part,
+        device const float * wgt,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    threadgroup float red[3584];
+    threadgroup int   lidx[2560];
+    threadgroup uint  sg_tot[16];
+    threadgroup float th_sh;
+    threadgroup int   n_sh;
+
+    const int t    = tpitg3.x;
+    const int nblk = args.ne01/32;
+    const int sub  = t / nblk;
+    const int blk  = t - sub*nblk;
+    const int per  = (args.ne00 + args.nchunk - 1)/args.nchunk;
+    const int i0   = tgpig.x*per;
+    const int i1   = min(args.ne00, i0 + per);
+
+    if (tgpig.x == 0) { for (int b = t; b < 2048; b += 448) hist_next[b] = 0u; }
+
+    // eşik: 256 iş parçacığı x 8 kutu
+    for (int rep = 0; rep < max(args.hist_x, 1); ++rep) {
+        uint c = 0;
+        if (t < 256) { for (int b = 0; b < 8; ++b) c += hist_cur[8*t + b]; }
+        uint inc = simd_prefix_inclusive_sum(c);
+        if (tiisg == 31) sg_tot[sgitg] = inc;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        uint base = 0;
+        for (ushort q = 0; q < sgitg; ++q) base += sg_tot[q];
+        const uint k = (uint) args.n_zero;
+        if (t < 256) {
+            const uint exc = base + inc - c;
+            if (k >= exc && k < exc + c) {
+                uint kk = k - exc; int b = 0;
+                for (; b < 8; ++b) { const uint cb = hist_cur[8*t + b]; if (kk < cb) break; kk -= cb; }
+                th_sh = as_type<float>(((uint) (8*t + b)) << 20);
+            }
+        }
+        if (args.n_zero <= 0 && t == 0) th_sh = 0.0f;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    const float th = th_sh;
+
+    // sıkıştırma: [i0, i1) -> lidx
+    for (int rep = 0; rep < max(args.comp_x, 1); ++rep)
+    for (int seg = i0; seg < i1; seg += 896) {
+        int r0 = seg + t, r1 = seg + t + 448;
+        const bool s0 = r0 < i1 && fabs(h[r0])*wgt[r0] >= th && h[r0] != 0.0f;
+        const bool s1 = r1 < i1 && fabs(h[r1])*wgt[r1] >= th && h[r1] != 0.0f;
+        uint my = (s0 ? 1u : 0u) + (s1 ? 1u : 0u);
+        uint inc = simd_prefix_inclusive_sum(my);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (tiisg == 31) sg_tot[sgitg] = inc;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        uint base = (seg == i0) ? 0u : (uint) n_sh, tot = base;
+        for (ushort q = 0; q < 14; ++q) { if (q < sgitg) base += sg_tot[q]; tot += sg_tot[q]; }
+        uint pos = base + inc - my;
+        if (s0) lidx[pos++] = r0;
+        if (s1) lidx[pos++] = r1;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (t == 0) n_sh = (int) tot;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    const int n = n_sh;
+    float xsum = 0.0f;
+
+    float acc[32];
+    for (int q = 0; q < 32; ++q) acc[q] = 0.0f;
+    device const char * wb = w + (uint64_t) blk*18;
+
+#define SEYREK_ROW(xd, qa, qb) { \
+        const ushort qq[8] = { qa.x, qa.y, qa.z, qa.w, qb.x, qb.y, qb.z, qb.w }; \
+        const float x1 = xd, x16 = xd*0.0625f, x256 = xd*0.00390625f, x4096 = xd*0.000244140625f; \
+        xsum += xd; \
+        for (int u = 0; u < 8; ++u) { \
+            const uint v = qq[u]; \
+            acc[2*u]      = fma((float)(v & 0x000Fu), x1,    acc[2*u]); \
+            acc[2*u + 16] = fma((float)(v & 0x00F0u), x16,   acc[2*u + 16]); \
+            acc[2*u + 1]  = fma((float)(v & 0x0F00u), x256,  acc[2*u + 1]); \
+            acc[2*u + 17] = fma((float)(v & 0xF000u), x4096, acc[2*u + 17]); \
+        } }
+
+    int l = sub;
+    for (; l + 28 < n; l += 32) {
+        int ii[8]; float x[8];
+        for (int r = 0; r < 8; ++r) { ii[r] = lidx[l + 4*r]; x[r] = h[ii[r]]; }
+        packed_ushort4 qa[8], qb[8]; ushort dd[8];
+        for (int r = 0; r < 8; ++r) {
+            device const ushort * p = (device const ushort *) (wb + (uint64_t) ii[r]*args.nb_row);
+            dd[r] = p[0];
+            qa[r] = *(device const packed_ushort4 *) (p + 1);
+            qb[r] = *(device const packed_ushort4 *) (p + 5);
+        }
+        for (int r = 0; r < 8; ++r) {
+            const float xd = x[r]*float(as_type<half>(dd[r]));
+            SEYREK_ROW(xd, qa[r], qb[r]);
+        }
+    }
+    for (; l < n; l += 4) {
+        const int i = lidx[l];
+        device const ushort * p = (device const ushort *) (wb + (uint64_t) i*args.nb_row);
+        const float xd = h[i]*float(as_type<half>(p[0]));
+        const packed_ushort4 qa = *(device const packed_ushort4 *) (p + 1);
+        const packed_ushort4 qb = *(device const packed_ushort4 *) (p + 5);
+        SEYREK_ROW(xd, qa, qb);
+    }
+#undef SEYREK_ROW
+    for (int q = 0; q < 32; ++q) acc[q] = fma(-8.0f, xsum, acc[q]);
+
+    const int c0 = blk*32;
+    for (int rep = 1; rep < args.red_x; ++rep) {
+        if (sub == 3) { for (int q = 0; q < 32; ++q) red[c0 + q] = acc[q]; }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sub == 2) { for (int q = 0; q < 32; ++q) acc[q] += red[c0 + q]*1e-30f; }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sub == 2) { for (int q = 0; q < 32; ++q) red[c0 + q] = acc[q]; }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sub == 1) { for (int q = 0; q < 32; ++q) acc[q] += red[c0 + q]*1e-30f; }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sub == 1) { for (int q = 0; q < 32; ++q) red[c0 + q] = acc[q]; }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sub == 0) { for (int q = 0; q < 32; ++q) acc[q] += red[c0 + q]*1e-30f; }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (sub == 3) { for (int q = 0; q < 32; ++q) red[c0 + q] = acc[q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 2) { for (int q = 0; q < 32; ++q) acc[q] += red[c0 + q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 2) { for (int q = 0; q < 32; ++q) red[c0 + q] = acc[q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 1) { for (int q = 0; q < 32; ++q) acc[q] += red[c0 + q]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sub == 1) { for (int q = 0; q < 32; ++q) red[c0 + q] = acc[q]; }
