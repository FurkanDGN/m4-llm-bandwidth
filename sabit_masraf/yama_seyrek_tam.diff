+int ggml_metal_sb_mode(void) {
+    static const int mode = []() {
+        const char * s = getenv("GGML_METAL_SB");
+        if (s == nullptr) {
+            return 1;
+        }
+        return strcmp(s, "0") == 0 ? 0 : (strcmp(s, "s") == 0 ? 2 : (strcmp(s, "m") == 0 ? 3 : 1));
+    }();
+    return mode;
+}
+
+bool ggml_metal_sb_matrix(int ne11) {
+    const int mode = ggml_metal_sb_mode();
+    return mode == 3 || (mode == 1 && ne11 >= 4);
